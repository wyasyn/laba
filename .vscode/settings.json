{
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit",
    "source.sortMembers": "explicit"
  },
  "java.compile.nullAnalysis.mode": "automatic",
  // android/ is generated by Expo prebuild. Importing it in the Java, Gradle and Kotlin
  // extensions starts several Gradle and Kotlin daemons (6+ GB of RAM), which froze the
  // machine whenever the emulator or an APK build ran on top of them.
  "java.import.gradle.enabled": false,
  "java.import.maven.enabled": false,
  "java.autobuild.enabled": false,
  "java.server.launchMode": "LightWeight",
  "gradle.autoDetect": "off",
  "kotlin.languageServer.enabled": false,
  "kotlin.debugAdapter.enabled": false,
  "files.watcherExclude": {
    "**/android/build/**": true,
    "**/android/app/build/**": true,
    "**/android/.gradle/**": true
  }
}
